<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/Preferences"
    android:background="@color/view_background"
    android:layout_height="match_parent"
    android:layout_width="match_parent"
    android:fitsSystemWindows="true"
    android:scrollbars="vertical"
    android:scrollbarAlwaysDrawVerticalTrack="false">
    <LinearLayout android:id="@+id/LinearLayout01"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <LinearLayout android:id="@+id/LinearLayout02"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView android:layout_width="wrap_content"
                android:id="@+id/PrefsTextSortBy"
                android:text="@string/PrefTextSortBy"
                android:layout_height="match_parent"
                android:gravity="center_vertical"/>
            <Spinner android:layout_height="wrap_content"
                android:id="@+id/PrefsSpinnerSortBy"
                android:entries="@array/PrefSortByList"
                android:layout_width="match_parent"/>
        </LinearLayout>

        <CheckBox android:text="@string/PrefTextShowCategory"
            android:id="@+id/PrefsCheckBoxShowCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <CheckBox android:text="@string/PrefTextShowPrivate"
            android:id="@+id/PrefsCheckBoxShowPrivate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:text="UI Theme: "/>
            <RadioGroup
                android:id="@+id/PrefsRadioGroupUITheme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RadioButton
                    android:id="@+id/PrefsRadioLightTheme"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Light"/>
                <RadioButton
                    android:id="@+id/PrefsRadioDarkTheme"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Dark"/>
                <RadioButton
                    android:id="@+id/PrefsRadioSystemTheme"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="System Default"
                    android:checked="true"/>
            </RadioGroup>
        </LinearLayout>

        <TextView android:id="@+id/PrefsTextScrollbarShow"
            android:text="@string/PrefTextScrollbarShow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"/>

        <com.xmission.trevin.android.notes.ui.ScrollBar
            android:id="@+id/PrefsScrollBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:thumbType="fixed"
            app:minLength="2"
            app:contentSize="1"/>

        <TextView android:id="@+id/PrefsTextScrollbarPages"
            android:text="@string/PrefTextScrollbarNever"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"/>
    </LinearLayout>
</ScrollView>
